# StudioFlow V2 Sample Environment Configuration
# All static branding, receipt terms, and studio details are centralized in src/constants/studio.ts

# Two ports, separated by the router:
#   8090 = CLIENT port (guest Wi-Fi): scripts/client-gateway.cjs, the kiosk build and only the
#          calls the kiosk makes. The guest network should reach this port only.
#   8091 = STAFF port (staff network): PocketBase itself, every station and the /_/ dashboard.
# The builds use these defaults. Change them here only if you also change run.bat / dev.bat.
# VITE_CLIENT_PORT=8090
# VITE_STAFF_PORT=8091

# Full addresses, only when the frontend is served from somewhere else (tunnel, reverse proxy).
# Production uses the page origin; Vite dev uses the browser hostname on the ports above.
# VITE_PB_URL=http://192.168.1.50:8091
# VITE_CLIENT_URL=http://192.168.1.50:8090

# Optional server process setting; run.bat does not load this file.
# STUDIOFLOW_PHOTOS_ROOT=C:\StudioFlow_Photos

# Vite dev servers: staff UI on 5173 (npm run dev), kiosk UI on 5174 (npm run dev:kiosk).
