# StudioFlow V2 Sample Environment Configuration
# All static branding, receipt terms, and studio details are centralized in src/constants/studio.ts

# PocketBase backend server URL
# Defaults automatically to http://<hostname>:8090 on localhost and LAN.
# Set if using a dedicated server IP or reverse proxy (e.g. http://192.168.1.50:8090)
# VITE_PB_URL=http://192.168.1.50:8090
# Optional server process setting; run.bat does not load this file.
# STUDIOFLOW_PHOTOS_ROOT=C:\StudioFlow_Photos
# Port configurations
VITE_PORT=5173
POCKETBASE_PORT=8090
