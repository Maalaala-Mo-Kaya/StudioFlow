{
  "name": "studioflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.cjs",
    "dev": "vite",
    "dev:kiosk": "vite --mode kiosk",
    "gateway": "node scripts/client-gateway.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "prebuild": "node scripts/copy-ocr-assets.cjs",
    "build": "npm run typecheck && vite build && vite build --mode kiosk",
    "postbuild": "node scripts/publish-build.cjs",
    "deploy": "npm run build",
    "lint": "eslint .",
    "test:gateway": "node --test scripts/test-client-gateway.cjs",
    "test:workflow": "node --test scripts/test-studio-workflow.cjs",
    "test:catalog": "node --test scripts/test-catalog-import.cjs",
    "check:excel": "node scripts/check-excel-math.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.68.0",
    "mammoth": "^1.13.0",
    "pocketbase": "^0.28.2",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "hyperformula": "^2.7.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.36.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "core-js@3.51.0": true
  }
}
